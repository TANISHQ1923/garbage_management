# =================================================================
# Smart Garbage Management API - Environment Configuration Template
# =================================================================
# Copy this file to .env and configure your values:
#   cp .env.example .env

# Port the Express server listens on
PORT=5000

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Atlas or local MongoDB connection URI
# Format for Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/garbage_management?retryWrites=true&w=majority
# Format for Local: mongodb://127.0.0.1:27017/garbage_management
MONGODB_URI=mongodb://127.0.0.1:27017/garbage_management

# JWT configuration
JWT_SECRET=super_secret_jwt_key_for_smart_garbage_management_2026
JWT_EXPIRES_IN=7d

# Allowed client origins for CORS (Use * for development or specific client URLs)
CLIENT_ORIGIN=*

# Cloudinary Cloud Storage Configuration (Required for Image/Video Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload Limits (in Megabytes)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# Python FastAPI AI Analysis Service (Step 9)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

